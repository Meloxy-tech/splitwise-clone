# Postgres connection string. Free options: Supabase, Neon, Railway.
# Example (Supabase pooled connection):
# DATABASE_URL="postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true"
DATABASE_URL="postgresql://user:password@localhost:5432/splitwise"

# NextAuth. Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"
